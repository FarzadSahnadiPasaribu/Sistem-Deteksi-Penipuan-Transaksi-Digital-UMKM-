# Sistem Deteksi Penipuan Transaksi Digital UMKM
# Salin file ini menjadi .env dan sesuaikan nilainya

# Database
DATABASE_URL=sqlite:///./data/umkm_fraud.db

# Model path
MODEL_PATH=backend/ml/saved_models

# API Settings
API_PREFIX=/api/v1

# Fraud thresholds
FRAUD_SCORE_ALERT=0.5
FRAUD_SCORE_CRITICAL=0.75
